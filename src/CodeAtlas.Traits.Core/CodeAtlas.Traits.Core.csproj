<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Garry Flanagan</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- Uncomment ENABLE_CPU_AUTO_TAGS (or pass -p:DefineConstants=ENABLE_CPU_AUTO_TAGS) to re-enable CPU keyword/thesaurus auto-tagging during scan -->
    <!-- <DefineConstants>$(DefineConstants);ENABLE_CPU_AUTO_TAGS</DefineConstants> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeAtlas.Traits.Abstractions\CodeAtlas.Traits.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Dictionaries\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
